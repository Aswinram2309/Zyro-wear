# Supabase Configuration (Source of Truth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Dashboard Access Control & Server Auth
ADMIN_EMAIL=admin@zyrowear.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=your_random_32_character_session_signing_secret

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend Transactional Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ZYRO Wear <orders@zyrowearonline.in>
